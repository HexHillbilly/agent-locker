# Agent Locker runtime configuration. Copy to .env and adjust.
#
# Daemon (lockerd) reads:  LOCKER_MODE, LOCKER_DB_PATH, LOCKER_READ_LEASE_SECONDS,
#                          LOCKER_HOST, LOCKER_PORT
# MCP server (lockermcp) reads:  LOCKER_URL

# --- daemon ---

# Auth mode: "local" (ticket bypass) or "x402" (payment validation; not wired in v1)
LOCKER_MODE=local

# SQLite database path (single-file, WAL mode)
LOCKER_DB_PATH=locker.db

# read_once ticket lease window, in seconds
LOCKER_READ_LEASE_SECONDS=600

# HTTP bind address / port
LOCKER_HOST=127.0.0.1
LOCKER_PORT=8000

# --- lockermcp (MCP server) ---

# URL of the daemon the MCP tools talk to
LOCKER_URL=http://127.0.0.1:8000
