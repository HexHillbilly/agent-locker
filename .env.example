# Agent Locker runtime configuration. Copy to .env and adjust.
#
# Daemon (lockerd) reads:  LOCKER_MODE, LOCKER_DB_PATH, LOCKER_READ_LEASE_SECONDS,
#                          LOCKER_HOST, LOCKER_PORT,
#                          PAYMENT_WALLET_ADDRESS, BASE_RPC_URL, REQUIRED_USDC_UNITS, USDC_CONTRACT
# MCP server (lockermcp) reads:  LOCKER_URL

# --- daemon ---

# Auth mode: "open" (open access, default), "dev" (alias), or "txid" (pay-per-pad
# via Base USDC tx-hash receipt checking). "local" and "x402" are legacy aliases.
LOCKER_MODE=open

# SQLite database path (single-file, WAL mode)
LOCKER_DB_PATH=locker.db

# read_once ticket lease window, in seconds
LOCKER_READ_LEASE_SECONDS=600

# HTTP bind address / port
LOCKER_HOST=127.0.0.1
LOCKER_PORT=8000

# --- txid payments (only used when LOCKER_MODE=txid) ---

# Receiving EVM address. Required when LOCKER_MODE=txid (daemon fails closed if unset).
PAYMENT_WALLET_ADDRESS=

# Base JSON-RPC endpoint
BASE_RPC_URL=https://mainnet.base.org

# Minimum payment in USDC atomic units (6 decimals); 2000 = $0.002
REQUIRED_USDC_UNITS=2000

# Base native USDC token contract
USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# --- lockermcp (MCP server) ---

# URL of the daemon the MCP tools talk to
LOCKER_URL=http://127.0.0.1:8000
